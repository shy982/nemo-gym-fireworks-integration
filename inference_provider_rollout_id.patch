+# NeMo Gym's model-call-capture middleware (_CaptureMiddleware, installed by
+# SimpleResponsesAPIModel.setup_webserver()) strips the `/ng-rollout/<id>`
+# correlation prefix before routing but never calls rollout_context(), so
+# current_rollout_id() is always None on a model server -- that contextvar is
+# only wired up by RolloutContextMiddleware, which base_resources_server.py
+# installs on resources servers, not model servers. Recover the id ourselves,
+# in a middleware added *after* setup_webserver() so it runs *before*
+# _CaptureMiddleware (Starlette: last-added middleware is outermost).
+_ROLLOUT_PREFIX_RE = re.compile(r"^/ng-rollout/(?P<rollout_id>[^/]+)(?P<rest>/.*)$")
+
+
+class _CaptureRolloutIdMiddleware:
+    def __init__(self, app: Any) -> None:
+        self._app = app
+
+    async def __call__(self, scope: dict, receive: Any, send: Any) -> None:
+        if scope.get("type") == "http":
+            match = _ROLLOUT_PREFIX_RE.match(scope.get("path", ""))
+            if match:
+                state = {**scope.get("state", {}), "ng_rollout_id": match.group("rollout_id")}
+                scope = {**scope, "state": state}
+        await self._app(scope, receive, send)
+
 
